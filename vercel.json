{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "dist",
  "functions": {
    "api/commerce.py": {
      "maxDuration": 300,
      "includeFiles": "server/*.py",
      "excludeFiles": "{dist/**,Entrenador/**,tests/**,scripts/**,supabase/**,private/**,archive/**,release/**,tmp/**,node_modules/**}"
    }
  },
  "crons": [
    {
      "path": "/api/commerce?action=operations",
      "schedule": "0 5 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/commerce",
      "dest": "/api/commerce"
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/aprender/frases-para-conversar",
      "status": 308,
      "headers": {
        "Location": "/aprender/frases-para-conversar/"
      }
    },
    {
      "src": "/aprender/frases-para-conversar/",
      "dest": "/aprender/frases-para-conversar/index.html"
    },
    {
      "src": "/aprender",
      "status": 308,
      "headers": {
        "Location": "/aprender/"
      }
    },
    {
      "src": "/aprender/",
      "dest": "/aprender/index.html"
    },
    {
      "src": "/aprender/practicar-con-ia",
      "status": 308,
      "headers": {
        "Location": "/aprender/practicar-con-ia/"
      }
    },
    {
      "src": "/aprender/practicar-con-ia/",
      "dest": "/aprender/practicar-con-ia/index.html"
    },
    {
      "src": "/aprender/recordar-vocabulario",
      "status": 308,
      "headers": {
        "Location": "/aprender/recordar-vocabulario/"
      }
    },
    {
      "src": "/aprender/recordar-vocabulario/",
      "dest": "/aprender/recordar-vocabulario/index.html"
    },
    {
      "src": "/comprar",
      "status": 308,
      "headers": {
        "Location": "/comprar/"
      }
    },
    {
      "src": "/comprar/",
      "dest": "/comprar/index.html"
    },
    {
      "src": "/contacto",
      "status": 308,
      "headers": {
        "Location": "/contacto/"
      }
    },
    {
      "src": "/contacto/",
      "dest": "/contacto/index.html"
    },
    {
      "src": "/cookies",
      "status": 308,
      "headers": {
        "Location": "/cookies/"
      }
    },
    {
      "src": "/cookies/",
      "dest": "/cookies/index.html"
    },
    {
      "src": "/cuenta",
      "status": 308,
      "headers": {
        "Location": "/cuenta/"
      }
    },
    {
      "src": "/cuenta/",
      "dest": "/cuenta/index.html"
    },
    {
      "src": "/entrega-y-reembolsos",
      "status": 308,
      "headers": {
        "Location": "/entrega-y-reembolsos/"
      }
    },
    {
      "src": "/entrega-y-reembolsos/",
      "dest": "/entrega-y-reembolsos/index.html"
    },
    {
      "src": "/pago",
      "status": 308,
      "headers": {
        "Location": "/pago/"
      }
    },
    {
      "src": "/pago/",
      "dest": "/pago/index.html"
    },
    {
      "src": "/premium",
      "status": 308,
      "headers": {
        "Location": "/premium/"
      }
    },
    {
      "src": "/premium/",
      "dest": "/premium/index.html"
    },
    {
      "src": "/privacidad",
      "status": 308,
      "headers": {
        "Location": "/privacidad/"
      }
    },
    {
      "src": "/privacidad/",
      "dest": "/privacidad/index.html"
    },
    {
      "src": "/terminos",
      "status": 308,
      "headers": {
        "Location": "/terminos/"
      }
    },
    {
      "src": "/terminos/",
      "dest": "/terminos/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
