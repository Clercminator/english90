{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/aprender/frases-para-conversar",
      "status": 308,
      "headers": {
        "Location": "/aprender/frases-para-conversar/"
      }
    },
    {
      "src": "/aprender/frases-para-conversar/",
      "dest": "/aprender/frases-para-conversar/index.html"
    },
    {
      "src": "/aprender",
      "status": 308,
      "headers": {
        "Location": "/aprender/"
      }
    },
    {
      "src": "/aprender/",
      "dest": "/aprender/index.html"
    },
    {
      "src": "/aprender/practicar-con-ia",
      "status": 308,
      "headers": {
        "Location": "/aprender/practicar-con-ia/"
      }
    },
    {
      "src": "/aprender/practicar-con-ia/",
      "dest": "/aprender/practicar-con-ia/index.html"
    },
    {
      "src": "/aprender/recordar-vocabulario",
      "status": 308,
      "headers": {
        "Location": "/aprender/recordar-vocabulario/"
      }
    },
    {
      "src": "/aprender/recordar-vocabulario/",
      "dest": "/aprender/recordar-vocabulario/index.html"
    },
    {
      "src": "/contacto",
      "status": 308,
      "headers": {
        "Location": "/contacto/"
      }
    },
    {
      "src": "/contacto/",
      "dest": "/contacto/index.html"
    },
    {
      "src": "/cookies",
      "status": 308,
      "headers": {
        "Location": "/cookies/"
      }
    },
    {
      "src": "/cookies/",
      "dest": "/cookies/index.html"
    },
    {
      "src": "/premium",
      "status": 308,
      "headers": {
        "Location": "/premium/"
      }
    },
    {
      "src": "/premium/",
      "dest": "/premium/index.html"
    },
    {
      "src": "/privacidad",
      "status": 308,
      "headers": {
        "Location": "/privacidad/"
      }
    },
    {
      "src": "/privacidad/",
      "dest": "/privacidad/index.html"
    },
    {
      "src": "/terminos",
      "status": 308,
      "headers": {
        "Location": "/terminos/"
      }
    },
    {
      "src": "/terminos/",
      "dest": "/terminos/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
