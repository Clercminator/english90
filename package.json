{
  "name": "english-90-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:data": "node scripts/validate-data.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "build": "npm run validate:data && npm run typecheck && vite build && node scripts/package-build.mjs",
    "preview": "node scripts/serve.mjs",
    "test:pdf": "python -m unittest discover -s tests -p test_pdf.py",
    "check:public": "node scripts/check-public-build.mjs",
    "package:public": "python scripts/package-release.py",
    "prepare:vercel": "node scripts/prepare-vercel.mjs",
    "prepare:git": "node scripts/prepare-git.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
